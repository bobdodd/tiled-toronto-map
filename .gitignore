# Large OSM data files - CRITICAL: exclude these
*.osm.pbf
*.osm
toronto-svg-tiles/data/

# Generated map tiles + their index/styles — build artifacts, reproducible from
# the manifest + OSM extract via build-tiles.py (~5 min) and published to the
# tile server with Tile Studio. Not committed (binary churn).
*.svg.gz
tile-generation/*-svg-tiles/tile-index.json
tile-generation/*-svg-tiles/styles/

# Archive folders
archive/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/

# Logs
logs/
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp
.tmp/
.temp/

# Test files and screenshots
test*.html
minimal.html
*.png
*.jpg
*.jpeg
*.gif

# Cache
.cache/
*.cache

# Strays that live in their own repos / are local scratch, not part of
# this project's published tree
ContextDescriptionApp/
demo-clean/
terminal-map/
tile-studio/
# Local dev: symlink to freshly generated tiles for ?tiles= validation
web-app/local-tiles
